#!/bin/bash
cd "$(dirname "$0")"
echo "=========================================="
echo "  Updating TV Streams & EPG (Unified)"
echo "=========================================="
python3 update_channels.py "$@"
echo ""
echo "Done! Files ready in ~/Desktop/1000-iptv/:"
echo "  - Playlist : ~/Desktop/1000-iptv/1000tv.m3u"
echo "  - EPG Guide: ~/Desktop/1000-iptv/1000epg.xml"
